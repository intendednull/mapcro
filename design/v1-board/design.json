    {
      "id": "accent",
      "label": "Live accent",
      "var": "--accent",
      "type": "color",
      "default": "#8ee0c4"
    },
    {
      "id": "amber",
      "label": "Amber team",
      "var": "--amber",
      "type": "color",
      "default": "#f2a93b"
    },
    {
      "id": "sapphire",
      "label": "Sapphire team",
      "var": "--sapphire",
      "type": "color",
      "default": "#6d8cff"
    },
    {
      "id": "density",
      "label": "Density",
      "var": "--space",
      "type": "select",
      "options": [
        {
          "label": "Compact",
          "value": "7px"
        },
        {
          "label": "Regular",
          "value": "9px"
        },
        {
          "label": "Roomy",
          "value": "11px"
        }
      ],
      "default": "9px"
    },
    {
      "id": "map-shade",
      "label": "Map darkness",
      "var": "--map-shade",
      "type": "range",
      "min": 0,
      "max": 0.7,
      "step": 0.05,
      "default": 0.2
    }
  ]
