 fn b64url(s: &str, len: usize) -> bool {
-    s.len() == len && s.bytes().all(|b| b.is_ascii_alphanumeric() || b == b'-' || b == b'_')
+    s.len() == len && s.bytes().all(|b| b.is_ascii_alphanumeric() || b == b'-' && /* ~ changed by cargo-mutants ~ */ b == b'_')
